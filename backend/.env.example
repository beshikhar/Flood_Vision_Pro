# ─────────────────────────────────────────────────────────────
#  FloodVision Pro – Backend Environment Configuration
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# CORS – comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Open-Meteo API base URL (no key needed – it's free & open)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# DataMeet GeoJSON district boundary source (Census 2011)
DISTRICT_GEOJSON_URL=https://raw.githubusercontent.com/datameet/maps/master/Districts/Census_2011/2011_Dist.geojson

# ── PostGIS / PostgreSQL (placeholder for production upgrade) ──
# Uncomment and fill when connecting a real PostGIS instance.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=floodvision
# DB_USER=postgres
# DB_PASSWORD=your_secure_password_here
